
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  padding: 20px;
  font-family: Arial, sans-serif;
  background: linear-gradient(135deg, #101827, #174b3a);
  color: white;
  min-height: 100vh;
}

.container {
  max-width: 600px;
  margin: 30px auto;
  padding: 25px;
  background: #1e293b;
  border-radius: 18px;
  box-shadow: 0 8px 30px #0005;
}

h1 {
  text-align: center;
  color: #38e08b;
}

p {
  text-align: center;
  color: #ddd;
}

label {
  display: block;
  margin-top: 20px;
  margin-bottom: 8px;
}

select, textarea {
  width: 100%;
  padding: 13px;
  border: 0;
  border-radius: 10px;
  font-size: 16px;
}

textarea {
  min-height: 110px;
  resize: vertical;
}

button {
  width: 100%;
  margin-top: 22px;
  padding: 15px;
  border: 0;
  border-radius: 10px;
  background: #16c779;
  color: #102018;
  font-size: 18px;
  font-weight: bold;
}

#result {
  margin-top: 20px;
  line-height: 1.8;
  white-space: pre-wrap;
}

